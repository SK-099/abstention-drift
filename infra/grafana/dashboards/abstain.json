{
 "uid": "abstain-rag",
 "title": "Abstention-aware RAG",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "tags": [
  "abstain",
  "llmops"
 ],
 "templating": {
  "list": [
   {
    "name": "collection",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": "label_values(assistant_turns_total, collection)",
    "includeAll": true,
    "multi": true,
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "allValue": ".*",
    "refresh": 2
   }
  ]
 },
 "panels": [
  {
   "type": "stat",
   "title": "Answers (24h)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "round(sum(increase(assistant_turns_total{collection=~\"$collection\"}[24h]))) or vector(0)"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "id": 1
  },
  {
   "type": "stat",
   "title": "Abstention rate (24h)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "(sum(increase(assistant_turns_total{decision=~\"abstain|clarify\",collection=~\"$collection\"}[24h])) / clamp_min(sum(increase(assistant_turns_total{collection=~\"$collection\"}[24h])),1e-9)) or vector(0)"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0,
     "max": 1
    },
    "overrides": []
   },
   "id": 2
  },
  {
   "type": "stat",
   "title": "p95 latency (1h)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(assistant_turn_seconds_bucket[1h])))"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "id": 3
  },
  {
   "type": "stat",
   "title": "Thumbs down (24h)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "round(sum(increase(feedback_events_total{rating=\"-1\"}[24h]))) or vector(0)"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "id": 4
  },
  {
   "type": "timeseries",
   "title": "Turns by decision",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (decision) (rate(assistant_turns_total{collection=~\"$collection\"}[$__rate_interval]))",
     "legendFormat": "{{decision}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "stacking": {
       "mode": "normal"
      },
      "drawStyle": "line",
      "lineInterpolation": "stepAfter",
      "spanNulls": true,
      "showPoints": "auto",
      "pointSize": 5
     }
    },
    "overrides": []
   },
   "id": 5
  },
  {
   "type": "timeseries",
   "title": "Abstention rate",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(assistant_turns_total{decision=~\"abstain|clarify\",collection=~\"$collection\"}[$__rate_interval])) / clamp_min(sum(rate(assistant_turns_total{collection=~\"$collection\"}[$__rate_interval])), 1e-9)",
     "legendFormat": "abstain + clarify"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "stacking": {
       "mode": "none"
      },
      "drawStyle": "line",
      "lineInterpolation": "stepAfter",
      "spanNulls": true,
      "showPoints": "auto",
      "pointSize": 5
     },
     "min": 0,
     "max": 1
    },
    "overrides": []
   },
   "id": 6
  },
  {
   "type": "timeseries",
   "title": "Abstention rate by collection",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (collection) (rate(assistant_turns_total{decision=~\"abstain|clarify\"}[$__rate_interval])) / clamp_min(sum by (collection) (rate(assistant_turns_total[$__rate_interval])), 1e-9)",
     "legendFormat": "{{collection}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "stacking": {
       "mode": "none"
      },
      "drawStyle": "line",
      "lineInterpolation": "stepAfter",
      "spanNulls": true,
      "showPoints": "auto",
      "pointSize": 5
     },
     "min": 0,
     "max": 1
    },
    "overrides": []
   },
   "id": 7
  },
  {
   "type": "timeseries",
   "title": "Retry rate (agent searched again)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(agent_retries_total[$__rate_interval])) / clamp_min(sum(rate(assistant_turns_total[$__rate_interval])), 1e-9)",
     "legendFormat": "retry"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "stacking": {
       "mode": "none"
      },
      "drawStyle": "line",
      "lineInterpolation": "stepAfter",
      "spanNulls": true,
      "showPoints": "auto",
      "pointSize": 5
     },
     "min": 0,
     "max": 1
    },
    "overrides": []
   },
   "id": 8
  },
  {
   "type": "timeseries",
   "title": "Turn latency",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le) (rate(assistant_turn_seconds_bucket[$__rate_interval])))",
     "legendFormat": "p50"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(assistant_turn_seconds_bucket[$__rate_interval])))",
     "legendFormat": "p95"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "stacking": {
       "mode": "none"
      },
      "drawStyle": "line",
      "lineInterpolation": "stepAfter",
      "spanNulls": true,
      "showPoints": "auto",
      "pointSize": 5
     }
    },
    "overrides": []
   },
   "id": 9
  },
  {
   "type": "timeseries",
   "title": "Time per agent stage (avg)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (stage) (rate(agent_stage_seconds_sum[$__rate_interval])) / clamp_min(sum by (stage) (rate(agent_stage_seconds_count[$__rate_interval])), 1e-9)",
     "legendFormat": "{{stage}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "stacking": {
       "mode": "none"
      },
      "drawStyle": "line",
      "lineInterpolation": "stepAfter",
      "spanNulls": true,
      "showPoints": "auto",
      "pointSize": 5
     }
    },
    "overrides": []
   },
   "id": 10
  },
  {
   "type": "timeseries",
   "title": "Feedback",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 28,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (rating, reason) (rate(feedback_events_total[$__rate_interval]))",
     "legendFormat": "{{rating}} {{reason}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "stacking": {
       "mode": "none"
      },
      "drawStyle": "line",
      "lineInterpolation": "stepAfter",
      "spanNulls": true,
      "showPoints": "auto",
      "pointSize": 5
     }
    },
    "overrides": []
   },
   "id": 11
  },
  {
   "type": "timeseries",
   "title": "Uploads",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 28,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (status) (increase(documents_indexed_total[$__rate_interval]))",
     "legendFormat": "{{status}}"
    },
    {
     "refId": "B",
     "expr": "sum(increase(injection_chunks_dropped_total[$__rate_interval]))",
     "legendFormat": "injection chunks dropped"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "stacking": {
       "mode": "none"
      },
      "drawStyle": "line",
      "lineInterpolation": "stepAfter",
      "spanNulls": true,
      "showPoints": "auto",
      "pointSize": 5
     }
    },
    "overrides": []
   },
   "id": 12
  },
  {
   "type": "timeseries",
   "title": "HTTP requests",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 36,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (http_target, http_status_code) (rate(http_server_duration_milliseconds_count[$__rate_interval]))",
     "legendFormat": "{{http_target}} {{http_status_code}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "stacking": {
       "mode": "none"
      },
      "drawStyle": "line",
      "lineInterpolation": "stepAfter",
      "spanNulls": true,
      "showPoints": "auto",
      "pointSize": 5
     }
    },
    "overrides": []
   },
   "id": 13
  },
  {
   "type": "timeseries",
   "title": "HTTP latency p95",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 36,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, http_target) (rate(http_server_duration_milliseconds_bucket[$__rate_interval])))",
     "legendFormat": "{{http_target}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ms",
     "custom": {
      "stacking": {
       "mode": "none"
      },
      "drawStyle": "line",
      "lineInterpolation": "stepAfter",
      "spanNulls": true,
      "showPoints": "auto",
      "pointSize": 5
     }
    },
    "overrides": []
   },
   "id": 14
  }
 ]
}